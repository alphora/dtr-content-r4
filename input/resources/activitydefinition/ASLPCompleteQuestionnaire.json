{
  "resourceType": "ActivityDefinition",
  "id": "ASLPCompleteQuestionnaire",
  "url": "http://example.org/sdh/dtr/aslp/ActivityDefinition/ASLPCompleteQuestionnaire",
  "name": "ASLPCompleteQuestionnaire",
  "title": "Complete Questionnaire",
  "status": "draft",
  "description": "Create a task to complete a Questionnaire.",
  "library": [
    "http://example.org/sdh/dtr/aslp/Library/ASLPCrdMultipleRequestLogic"
  ],
  "kind": "Task",
  "code": {
    "coding": [
      {
        "system": "http://hl7.org/fhir/uv/cpg/CodeSystem/cpg-activity-type-cs",
        "code": "collect-information"
      }
    ]
  }, 
  "dynamicValue": [
    {
      "path": "status",
      "expression": {
        "language": "text/fhirpath",
        "expression": "'requested'"
      }
    },
    {
      "path": "intent",
      "expression": {
        "language": "text/fhirpath",
        "expression": "'order'"
      }
    },
    {
      "path": "businessStatus",
      "expression": {
        "language": "text/cql-identifier",
        "expression": "AdjudicationOutcome"
      }
    },
    {
      "path": "statusReason",
      "expression": {
        "language": "text/cql-identifier",
        "expression": "AdjudicationRationale"
      }
    },
    {
      "path": "reasonCode",
      "expression": {
        "language": "text/cql-identifier",
        "expression": "AdjudicationReasonCodes"
      }
    }, 
    {
      "path": "action.resource",
      "expression": {
        "language": "text/cql-identifier",
        "expression": "CompleteQuestionnaireForTask"
      }
    }
  ]
}